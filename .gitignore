# Android: the release signing key and its passwords never go into git (keep them in two safe places instead),
# nor build output, the SDK path or the built web copy.
android/keystore.properties
android/*.jks
android/*.keystore
*.jks
android/local.properties
android/.gradle
android/build
android/app/build
android/app/src/main/assets/public
*.apk
*.aab

# The tutorial videos are large (about 600 MB): they go to YouTube, not into git. Captions, thumbnails and lists stay.
user video/**/*.webm

