# Leave empty to run in offline/device mode (data stays on each device).
# Fill both to use a shared cloud database (free Supabase project).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Required for cloud sign-up and access: set to 1 only after an SMS provider is set up in Supabase
# (Authentication → Providers → Phone) and, in India, DLT-registered. Mobile numbers are then verified by code.
# Password reset still offers email and SMS as independent alternatives.
VITE_PHONE_OTP=
# Your live website address, no trailing slash (e.g. https://app.example.in). Needed when building the Android app in
# cloud mode, so confirm-email and reset-password links open the website.
VITE_PUBLIC_URL=
